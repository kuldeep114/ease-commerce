NODE_ENV=test
PORT=3101
LOG_LEVEL=silent
LOG_PRETTY=false

API_KEY=test-api-key

DATABASE_URL=postgres://postgres:postgres@localhost:55432/courier_platform_test

COURIER_TIMEOUT_MS=2000
COURIER_MAX_RETRIES=2
COURIER_RETRY_BASE_MS=10

BULK_MAX_ORDERS=100
BULK_CONCURRENCY=5

# The UrbaneBolt adapter is exercised against nock, never the real sandbox, so the tests stay
# fast and deterministic and never depend on someone else's uptime.
URBANEBOLT_ENABLED=true
URBANEBOLT_BASE_URL=https://urbanebolt.test
URBANEBOLT_USERNAME=test-user
URBANEBOLT_PASSWORD=test-password
URBANEBOLT_CUSTOMER_CODE=TESTCUS001

MOCK_ENABLED=true
MOCK_FAILURE_RATE=0
MOCK_LATENCY_MS=0
MOCK_AUTO_ADVANCE=true
