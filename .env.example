# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

# Shared secret every consumer sends as the `x-api-key` header.
API_KEY=local-dev-key

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:55432/courier_platform

# ---------------------------------------------------------------------------
# Courier defaults — every adapter inherits these unless it overrides them with
# its own <COURIER>_ prefixed variable.
# ---------------------------------------------------------------------------
COURIER_TIMEOUT_MS=15000
COURIER_MAX_RETRIES=2
COURIER_RETRY_BASE_MS=500

# ---------------------------------------------------------------------------
# Bulk processing
# ---------------------------------------------------------------------------
BULK_MAX_ORDERS=100
BULK_CONCURRENCY=10

# ---------------------------------------------------------------------------
# UrbaneBolt
# Credentials below are the public UAT ones from the integration docs. Replace
# them with your own for any non-sandbox environment.
# ---------------------------------------------------------------------------
URBANEBOLT_ENABLED=true
URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_USERNAME=
URBANEBOLT_PASSWORD=
URBANEBOLT_CUSTOMER_CODE=

# ---------------------------------------------------------------------------
# MockCourier — a real second adapter, used by the tests and handy for demos.
# FAILURE_RATE is the probability (0-1) that a create call fails, which makes
# partial-success behaviour on a bulk request easy to show.
# ---------------------------------------------------------------------------
MOCK_ENABLED=true
MOCK_FAILURE_RATE=0
MOCK_LATENCY_MS=0
MOCK_AUTO_ADVANCE=true
