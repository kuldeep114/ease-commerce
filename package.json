{
  "name": "multi-courier-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Unified, courier-agnostic logistics API with pluggable courier adapters",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js latest",
    "migrate:rollback": "node scripts/migrate.js rollback",
    "pretest": "node --env-file=.env.test scripts/migrate.js latest",
    "test": "node --env-file=.env.test --test --test-concurrency=1 tests/",
    "test:unit": "node --env-file=.env.test --test tests/unit/"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nock": "^13.5.6",
    "supertest": "^7.0.0"
  }
}
